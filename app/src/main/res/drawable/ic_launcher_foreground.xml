<?xml version="1.0" encoding="utf-8"?>
<!--
  런처 아이콘 전면 — 여백 심볼.
  '거의 닫힌 원(고리)' + 가운데 한 점. 고리의 트인 곳과 점 주변의 빈 자리가
  브랜드 이름 그대로 '여백'을 뜻한다. 어댑티브 아이콘 안전 영역(가운데 66dp) 안에 들어간다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 트인 고리 -->
    <path
        android:pathData="M64.5,35.81 A21,21 0 1,1 43.5,35.81"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFF1F7F6"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
    <!-- 가운데 점 -->
    <path
        android:pathData="M60.5,54 A6.5,6.5 0 1,1 47.5,54 A6.5,6.5 0 1,1 60.5,54"
        android:fillColor="#FF8DBAB9" />
</vector>
