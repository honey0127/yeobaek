<?xml version="1.0" encoding="utf-8"?>
<!--
  여백 컴포넌트 스타일.

  레이아웃에서 cardCornerRadius/strokeColor/cornerRadius 를 매번 손으로 적으면
  화면마다 값이 어긋난다. 카드·버튼·배지는 아래 스타일만 쓴다.

  ※ 색을 함부로 덮지 않는다.
    Material 의 버튼/칩 색은 단일 색이 아니라 **상태별 색 목록**(ColorStateList)이다.
    여기서 backgroundTint 를 단색으로 덮으면 '비활성(enabled=false)' 상태가 회색으로
    바뀌지 않아, 누를 수 없는 버튼이 멀쩡해 보인다(홈의 '코스 만들기'가 그렇다).
    그래서 이 파일은 **모양과 글자만** 정하고 색은 테마(colorPrimary 등)에 맡긴다.
-->
<resources>

    <!-- ════ 카드 ════
         기본은 '그림자 없는 헤어라인 카드'. 종이 한 장을 얹은 느낌만 주고
         그림자는 진짜로 떠 있어야 하는 것(Floating)에만 허용한다. -->
    <style name="Ye.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ye_surface</item>
        <item name="cardCornerRadius">@dimen/ye_radius_md</item>
        <item name="cardElevation">@dimen/ye_elev_flat</item>
        <item name="strokeColor">@color/ye_outline</item>
        <item name="strokeWidth">@dimen/ye_stroke</item>
    </style>

    <!-- 브랜드 틴트 카드 — 화면당 하나(요약/히어로) -->
    <style name="Ye.Card.Brand">
        <item name="cardBackgroundColor">@color/ye_primary_container</item>
        <item name="cardCornerRadius">@dimen/ye_radius_lg</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- 지도 위에 실제로 떠 있는 것(검색바 등) -->
    <style name="Ye.Card.Floating">
        <item name="cardCornerRadius">@dimen/ye_radius_xl</item>
        <item name="cardElevation">@dimen/ye_elev_float</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ════ 버튼 ════
         insetTop/Bottom 을 0 으로 두어야 layout_height 가 실제 높이가 된다
         (Material 기본 6dp 인셋 때문에 52dp 로 줘도 40dp 로 보인다).
         색·비활성 처리는 부모 스타일 그대로 둔다. -->
    <style name="Ye.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/ye_button_h</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/ye_radius_sm</item>
        <item name="iconSize">@dimen/ye_icon_md</item>
        <item name="iconPadding">@dimen/ye_space_xs</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Ye.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/ye_button_h</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/ye_radius_sm</item>
        <item name="iconSize">@dimen/ye_icon_md</item>
        <item name="iconPadding">@dimen/ye_space_xs</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Ye.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/ye_button_h</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/ye_radius_sm</item>
        <item name="iconSize">@dimen/ye_icon_md</item>
        <item name="iconPadding">@dimen/ye_space_xs</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Ye.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/ye_touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/ye_radius_xs</item>
        <item name="iconSize">@dimen/ye_icon_md</item>
        <item name="iconPadding">@dimen/ye_space_2xs</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- 작은 인라인 버튼(카드 안 "담기" 등) -->
    <style name="Ye.Button.Tonal.Compact">
        <item name="android:minHeight">@dimen/ye_button_h_sm</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/ye_space_sm</item>
        <item name="android:paddingEnd">@dimen/ye_space_sm</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">@dimen/ye_radius_xs</item>
        <item name="iconSize">@dimen/ye_icon_sm</item>
        <item name="iconPadding">@dimen/ye_space_2xs</item>
    </style>

    <!-- 아이콘만 있는 버튼. text 가 비어 있을 때 iconGravity=textStart 면 아이콘이
         가운데로 온다(빈 텍스트가 중앙 정렬되기 때문) — 아이콘 전용 버튼의 정석. -->
    <style name="Ye.Button.Icon.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:text">@string/ye_empty</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">@dimen/ye_icon_lg</item>
        <item name="cornerRadius">@dimen/ye_radius_sm</item>
    </style>

    <!-- ════ 칩 ════
         글자 크기/서체만 직접 지정한다. textAppearance 로 주면 그 안의 textColor 가
         칩의 '선택됨' 글자색(상태별 색 목록)과 부딪힌다. -->
    <style name="Ye.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ye_chip_text</item>
        <item name="chipBackgroundColor">@color/ye_chip_bg</item>
        <item name="chipStrokeColor">@color/ye_outline</item>
        <item name="chipStrokeWidth">@dimen/ye_stroke</item>
        <item name="chipIconTint">@color/ye_chip_icon</item>
        <item name="chipIconSize">@dimen/ye_icon_sm</item>
        <item name="closeIconTint">@color/ye_chip_icon</item>
    </style>

    <style name="Ye.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ye_chip_text</item>
        <item name="chipBackgroundColor">@color/ye_chip_bg</item>
        <item name="chipStrokeColor">@color/ye_outline</item>
        <item name="chipStrokeWidth">@dimen/ye_stroke</item>
        <item name="chipIconTint">@color/ye_chip_icon</item>
        <item name="chipIconSize">@dimen/ye_icon_sm</item>
    </style>

    <!-- 담은 장소를 지울 수 있는 칩(홈 시트) -->
    <!-- 담은 장소 칩은 '이미 내 코스에 들어간 것'이라 브랜드 틴트로 채운다.
         선택 상태가 없는(checkable=false) 칩이라 단색으로 줘도 안전하다. -->
    <style name="Ye.Chip.Input" parent="Widget.Material3.Chip.Input">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ye_on_primary_container</item>
        <item name="chipBackgroundColor">@color/ye_primary_container</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="closeIconTint">@color/ye_on_primary_container</item>
    </style>

    <!-- ════ 혼잡 배지 ════
         배경 색은 코드에서 backgroundTintList 로, 글자색은 setTextColor 로 넣는다
         (레벨별 색 + 다크 테마 대응). 여기서는 모양만 잡는다. -->
    <style name="Ye.Badge" parent="">
        <item name="android:background">@drawable/ye_badge</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ye_on_surface</item>
        <item name="android:paddingStart">@dimen/ye_space_xs</item>
        <item name="android:paddingEnd">@dimen/ye_space_xs</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

</resources>
