<?xml version="1.0" encoding="utf-8"?>
<!--
  빠른 선택 지역 칩.

  예전에는 그냥 TextView 에 shape 배경을 씌우고 코드에서 backgroundTint 로 선택 상태를
  칠했다 — 리플(누른 느낌)도 없고 높이가 40dp 도 안 돼 누르기 어려웠다.
  진짜 Material Chip 을 쓰면 선택 상태·리플·터치 타깃을 컴포넌트가 알아서 처리한다.
-->
<com.google.android.material.chip.Chip
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/district_chip"
    style="@style/Ye.Chip.Filter"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/ye_space_xs"
    android:checkable="true"
    tools:text="성수" />
