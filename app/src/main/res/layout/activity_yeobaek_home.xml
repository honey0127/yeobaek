<?xml version="1.0" encoding="utf-8"?>
<!--
  홈 — 풀스크린 지도 + 상단 검색/필터 + 하단 코스 시트.

  이전 버전은 지도 위 컨트롤(에코 칩·스탬프 칩·제보 버튼·필터 칩)을
  layout_marginTop="78dp/116dp/124dp" 같은 상수로 하나씩 띄워 놓았다. 상태바 높이가
  기기마다 달라 노치 기기에서 겹치고, 컨트롤이 사방에 흩어져 지도를 가렸다.

  지금은 상단의 모든 컨트롤이 top_bar 하나에 세로로 쌓여 있고, 상태바 높이만큼의
  여백은 YeobaekHomeActivity 가 YeUi.applyInsets 로 넣는다 — 상수 마진이 없다.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ye_background">

    <!-- 지도(구글맵, ye_map_style 로 그린 톤 / 다크 모드는 야간 스타일) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map_fragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ══ 상단 컨트롤 묶음 ══
         상태바 인셋은 코드에서 이 뷰의 패딩으로 들어간다. -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="@dimen/ye_space_sm">

        <!-- 검색 알약 + 내 여백 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/ye_gutter">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_bar"
                style="@style/Ye.Card.Floating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/home_search_cd">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ye_touch_min"
                    android:paddingHorizontal="@dimen/ye_space_md">

                    <ImageView
                        android:layout_width="@dimen/ye_icon_md"
                        android:layout_height="@dimen/ye_icon_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ye_search"
                        app:tint="@color/ye_on_surface_variant" />

                    <TextView
                        style="@style/Ye.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ye_space_sm"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/home_search_hint"
                        android:textColor="@color/ye_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 에코 포인트 = 내 여백 입구. 예전엔 포인트 칩과 스탬프 칩이 지도 위에
                 따로 떠 있었는데, 둘 다 같은 화면으로 가므로 하나로 합쳤다. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/eco_pill"
                style="@style/Ye.Card.Floating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ye_space_xs"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/home_eco_cd">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:minWidth="@dimen/ye_touch_min"
                    android:minHeight="@dimen/ye_touch_min"
                    android:paddingHorizontal="@dimen/ye_space_sm">

                    <ImageView
                        android:layout_width="@dimen/ye_icon_md"
                        android:layout_height="@dimen/ye_icon_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ye_eco"
                        app:tint="@color/ye_eco" />

                    <TextView
                        android:id="@+id/eco_chip"
                        style="@style/Ye.Text.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ye_space_2xs"
                        android:textColor="@color/ye_on_surface"
                        tools:text="120" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 지도 필터/액션 칩 줄 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ye_space_xs"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/ye_gutter"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/ye_space_xs"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_quiet_only"
                    style="@style/Ye.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/home_filter_quiet"
                    app:checkedIconVisible="false"
                    app:chipIcon="@drawable/ic_ye_eco"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_legend"
                    style="@style/Ye.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/home_filter_legend"
                    app:checkedIconVisible="false"
                    app:chipIcon="@drawable/ic_ye_layers"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_report"
                    style="@style/Ye.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_action_report"
                    app:chipIcon="@drawable/ic_ye_report"
                    app:chipIconVisible="true" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- 이 지역 추천(지도를 옮기면 나타난다) -->
        <LinearLayout
            android:id="@+id/reco_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ye_space_sm"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ye_gutter"
                android:background="@drawable/ye_bg_pill_brand"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ye_space_sm"
                android:paddingEnd="@dimen/ye_space_2xs">

                <TextView
                    android:id="@+id/reco_header"
                    style="@style/Ye.Text.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_reco_default"
                    android:textColor="@color/ye_on_primary_container" />

                <ImageButton
                    android:id="@+id/reco_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_reco_close_cd"
                    android:padding="@dimen/ye_space_xs"
                    android:src="@drawable/ic_ye_close"
                    app:tint="@color/ye_on_primary_container" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/reco_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ye_space_xs"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/ye_gutter"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ 혼잡 범례 — 접힌 시트 바로 위 ══ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/heat_legend"
        style="@style/Ye.Card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/ye_gutter"
        android:layout_marginBottom="@dimen/ye_map_overlay_bottom"
        app:cardCornerRadius="@dimen/ye_radius_xs">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ye_space_sm"
            android:paddingVertical="@dimen/ye_space_xs">

            <TextView
                style="@style/Ye.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_legend_title"
                android:textColor="@color/ye_on_surface_variant" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ye_space_2xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/ye_legend_dot"
                    android:backgroundTint="@color/ye_lv1" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/ye_space_2xs"
                    android:background="@drawable/ye_legend_dot"
                    android:backgroundTint="@color/ye_lv2" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/ye_space_2xs"
                    android:background="@drawable/ye_legend_dot"
                    android:backgroundTint="@color/ye_lv3" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="@dimen/ye_space_2xs"
                    android:background="@drawable/ye_legend_dot"
                    android:backgroundTint="@color/ye_lv4" />
            </LinearLayout>

            <TextView
                style="@style/Ye.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ye_space_3xs"
                android:text="@string/home_legend_scale" />

            <TextView
                style="@style/Ye.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_legend_unknown" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══ 코스 시트 ══ -->
    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ye_sheet_bg"
        android:elevation="@dimen/ye_elev_sheet"
        android:orientation="vertical"
        app:behavior_draggable="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/ye_sheet_peek"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <FrameLayout
            android:id="@+id/sheet_handle_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/home_sheet_handle_cd"
            android:paddingTop="@dimen/ye_space_sm"
            android:paddingBottom="@dimen/ye_space_xs">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/ye_handle" />
        </FrameLayout>

        <!-- 접힘 상태에서 보이는 줄: 담은 개수 + 요약 + CTA.
             이 줄 높이 + 손잡이 높이 + 내비바 높이가 곧 시트의 peek 높이다(코드에서 계산). -->
        <LinearLayout
            android:id="@+id/sheet_collapsed_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ye_gutter"
            android:paddingBottom="@dimen/ye_space_md">

            <TextView
                android:id="@+id/sheet_count"
                style="@style/Ye.Text.Label"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="@dimen/ye_space_sm"
                android:background="@drawable/ye_bg_circle_tint"
                android:backgroundTint="@color/ye_primary_container"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="0"
                android:textColor="@color/ye_on_primary_container" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sheet_summary"
                    style="@style/Ye.Text.TitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_sheet_empty_title" />

                <TextView
                    android:id="@+id/sheet_summary_sub"
                    style="@style/Ye.Text.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ye_space_3xs"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_sheet_empty_sub" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_plan"
                style="@style/Ye.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ye_button_h"
                android:layout_marginStart="@dimen/ye_space_sm"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/ye_space_md"
                android:text="@string/home_plan"
                app:icon="@drawable/ic_ye_route" />
        </LinearLayout>

        <!-- 펼쳤을 때: 출발 시각 · 담은 장소 · 코스 방식 -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/sheet_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/ye_gutter"
            android:paddingBottom="@dimen/ye_space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Ye.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_when" />

                <!-- 날짜 · 시각: 입력창이 아니라 '눌러서 고르는 값'이라 필드처럼 보이게 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ye_space_xs"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/field_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/ye_bg_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/ye_touch_min"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/ye_space_sm">

                        <ImageView
                            android:layout_width="@dimen/ye_icon_md"
                            android:layout_height="@dimen/ye_icon_md"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ye_calendar"
                            app:tint="@color/ye_on_surface_variant" />

                        <TextView
                            android:id="@+id/input_date"
                            style="@style/Ye.Text.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/ye_space_xs"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="8월 15일 (금)" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/field_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ye_space_xs"
                        android:background="@drawable/ye_bg_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/ye_touch_min"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/ye_space_sm">

                        <ImageView
                            android:layout_width="@dimen/ye_icon_md"
                            android:layout_height="@dimen/ye_icon_md"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ye_clock"
                            app:tint="@color/ye_on_surface_variant" />

                        <TextView
                            android:id="@+id/input_time"
                            style="@style/Ye.Text.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/ye_space_xs"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="14:00" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Ye.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ye_space_lg"
                    android:text="@string/home_stops_label" />

                <TextView
                    android:id="@+id/stops_empty"
                    style="@style/Ye.Text.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ye_space_2xs"
                    android:text="@string/home_stops_empty" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ye_space_xs"
                    app:chipSpacingVertical="@dimen/ye_space_3xs" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_place"
                    style="@style/Ye.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ye_space_2xs"
                    android:paddingHorizontal="@dimen/ye_space_xs"
                    android:text="@string/home_add_place"
                    app:icon="@drawable/ic_ye_add" />

                <TextView
                    style="@style/Ye.Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ye_space_md"
                    android:text="@string/home_mode_label" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/mode_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ye_space_xs"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mode_auto"
                        style="@style/Ye.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_mode_auto" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mode_keep"
                        style="@style/Ye.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_mode_keep" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/mode_hint"
                    style="@style/Ye.Text.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ye_space_xs"
                    android:text="@string/home_mode_hint_auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_district"
                    style="@style/Ye.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ye_space_lg"
                    android:text="@string/home_area_planner"
                    app:icon="@drawable/ic_ye_place" />

                <ProgressBar
                    android:id="@+id/home_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/ye_space_sm"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- ══ 장소 상세 시트 — 핀/명소를 탭하거나 검색했을 때만 올라온다 ══ -->
    <LinearLayout
        android:id="@+id/place_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ye_sheet_bg"
        android:elevation="24dp"
        android:orientation="vertical"
        android:paddingBottom="@dimen/ye_space_lg"
        app:behavior_draggable="true"
        app:behavior_hideable="true"
        app:behavior_skipCollapsed="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/ye_space_sm"
            android:layout_marginBottom="@dimen/ye_space_md"
            android:background="@drawable/ye_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ye_gutter">

            <TextView
                android:id="@+id/info_title"
                style="@style/Ye.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="경복궁" />

            <ImageButton
                android:id="@+id/info_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/ye_space_xs"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ye_close"
                android:padding="@dimen/ye_space_xs"
                android:src="@drawable/ic_ye_close"
                app:tint="@color/ye_on_surface_variant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ye_space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ye_gutter">

            <TextView
                android:id="@+id/info_level"
                style="@style/Ye.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ye_space_xs"
                android:visibility="gone"
                tools:text="여유"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/info_meta"
                style="@style/Ye.Text.BodySmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="고궁 · 한적함 72 · 1.4km" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ye_space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ye_gutter">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/info_add"
                style="@style/Ye.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/ye_button_h"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/place_add"
                app:icon="@drawable/ic_ye_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/info_fav"
                style="@style/Ye.Button.Icon.Tonal"
                android:layout_width="@dimen/ye_button_h"
                android:layout_height="@dimen/ye_button_h"
                android:layout_marginStart="@dimen/ye_space_xs"
                android:contentDescription="@string/place_fav_cd"
                app:icon="@drawable/ic_ye_heart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/info_offpeak"
                style="@style/Ye.Button.Icon.Tonal"
                android:layout_width="@dimen/ye_button_h"
                android:layout_height="@dimen/ye_button_h"
                android:layout_marginStart="@dimen/ye_space_xs"
                android:contentDescription="@string/place_offpeak_cd"
                app:icon="@drawable/ic_ye_clock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/info_disperse"
                style="@style/Ye.Button.Icon.Tonal"
                android:layout_width="@dimen/ye_button_h"
                android:layout_height="@dimen/ye_button_h"
                android:layout_marginStart="@dimen/ye_space_xs"
                android:contentDescription="@string/place_disperse_cd"
                app:icon="@drawable/ic_ye_disperse" />
        </LinearLayout>

        <TextView
            style="@style/Ye.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ye_space_xs"
            android:paddingHorizontal="@dimen/ye_gutter"
            android:text="@string/place_action_hint" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
