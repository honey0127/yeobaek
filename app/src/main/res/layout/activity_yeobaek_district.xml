<?xml version="1.0" encoding="utf-8"?>
<!--
  위치 기준 코스 플래너: 기준 위치 선택 → 주변 명소 라인업 담기 → 코스 만들기.

  로딩은 스피너 대신 스켈레톤(올라올 카드 모양의 회색 블록)으로 보여준다 —
  "무엇이 올지"가 먼저 보이면 같은 시간도 덜 길게 느껴진다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/district_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ye_background"
    android:orientation="vertical">

    <!-- ── 상단 바 ── -->
    <LinearLayout
        android:id="@+id/district_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ye_space_xs"
        android:paddingTop="@dimen/ye_space_xs"
        android:paddingEnd="@dimen/ye_gutter"
        android:paddingBottom="@dimen/ye_space_2xs">

        <ImageButton
            android:id="@+id/district_back"
            android:layout_width="@dimen/ye_touch_min"
            android:layout_height="@dimen/ye_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ye_back"
            android:padding="@dimen/ye_space_sm"
            android:src="@drawable/ic_ye_arrow_back"
            app:tint="@color/ye_on_surface" />

        <TextView
            style="@style/Ye.Text.TitleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ye_space_2xs"
            android:layout_weight="1"
            android:text="@string/district_title" />
    </LinearLayout>

    <TextView
        style="@style/Ye.Text.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/ye_gutter"
        android:paddingBottom="@dimen/ye_space_sm"
        android:text="@string/district_sub" />

    <!-- 기준 위치 선택 바 (탭하면 장소 검색으로 위치 변경) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/center_bar"
        style="@style/Ye.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ye_gutter"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/ye_touch_min"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ye_space_sm"
            android:paddingVertical="@dimen/ye_space_xs">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ye_bg_circle_tint"
                android:backgroundTint="@color/ye_primary_container"
                android:importantForAccessibility="no"
                android:padding="@dimen/ye_space_xs"
                android:src="@drawable/ic_ye_place"
                app:tint="@color/ye_on_primary_container" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ye_space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Ye.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/district_center" />

                <TextView
                    android:id="@+id/center_name"
                    style="@style/Ye.Text.TitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/district_center_empty" />
            </LinearLayout>

            <TextView
                style="@style/Ye.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/district_change"
                android:textColor="@color/ye_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 빠른 선택: 대표 지역 프리셋 (가로 스크롤) -->
    <TextView
        style="@style/Ye.Text.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ye_space_md"
        android:paddingHorizontal="@dimen/ye_gutter"
        android:text="@string/district_quick" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/district_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ye_space_xs"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/ye_gutter"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <TextView
        android:id="@+id/district_desc"
        style="@style/Ye.Text.BodySmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/ye_gutter"
        android:paddingTop="@dimen/ye_space_sm"
        android:paddingBottom="@dimen/ye_space_2xs"
        tools:text="성수 주변 3km 명소" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lineup_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/ye_space_2xs"
            android:paddingBottom="@dimen/ye_space_md" />

        <!-- 로딩 스켈레톤 -->
        <LinearLayout
            android:id="@+id/lineup_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <include layout="@layout/view_skeleton_row" />

            <include layout="@layout/view_skeleton_row" />

            <include layout="@layout/view_skeleton_row" />

            <include layout="@layout/view_skeleton_row" />
        </LinearLayout>

        <!-- 비어 있음 / 오류 상태 -->
        <LinearLayout
            android:id="@+id/lineup_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ye_space_2xl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/lineup_state_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:alpha="0.5"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ye_map"
                app:tint="@color/ye_on_surface_faint" />

            <TextView
                android:id="@+id/lineup_empty"
                style="@style/Ye.Text.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ye_space_sm"
                android:gravity="center"
                tools:text="주변에 등록된 명소가 없어요" />
        </LinearLayout>
    </FrameLayout>

    <!-- 하단 바: 담은 개수 + 코스 만들기 -->
    <LinearLayout
        android:id="@+id/district_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ye_bg_top_hairline"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/ye_gutter"
        android:paddingVertical="@dimen/ye_space_sm">

        <TextView
            android:id="@+id/course_count"
            style="@style/Ye.Text.TitleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="내 코스 3곳" />

        <ProgressBar
            android:id="@+id/course_progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/ye_space_sm"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_make_course"
            style="@style/Ye.Button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ye_button_h"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/ye_space_lg"
            android:text="@string/district_make"
            app:icon="@drawable/ic_ye_route" />
    </LinearLayout>
</LinearLayout>
