<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ye_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- NoActionBar 테마라 화면 제목은 레이아웃이 직접 그린다 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="내 여백"
            android:textColor="@color/ye_on_surface"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 에코 트래블러 요약 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ye_primary_container"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/my_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="입문 여행자"
                    android:textColor="@color/ye_on_primary_container"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/my_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="🌱 0 포인트"
                    android:textColor="@color/ye_on_primary_container"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/my_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/ye_primary" />

                <TextView
                    android:id="@+id/my_next_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="@color/ye_on_primary_container"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 저장한 코스 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="저장한 코스"
            android:textColor="@color/ye_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/my_courses_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="아직 저장한 코스가 없어요.\n플래너에서 ‘코스 저장’을 누르면 여기에 쌓입니다."
            android:textColor="@color/ye_on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/my_courses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- 여백 스탬프 -->
        <TextView
            android:id="@+id/my_stamps_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="여백 스탬프"
            android:textColor="@color/ye_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/my_stamps_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="지도에서 장소를 담으면 스탬프가 찍혀요."
            android:textColor="@color/ye_on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/my_stamps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingVertical="2dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
