<?xml version="1.0" encoding="utf-8"?>
<!--
  대안 카드 — "왜 이 곳으로 바꾸는 게 나은가"를 근거와 함께 보여주고 원탭으로 교체한다.

  카드 자체가 공유 이미지로 캡처되는 뷰(card_container)라, 카드 안에는 버튼 같은
  조작 요소를 넣지 않는다 — 캡처 이미지에 버튼이 찍히면 이상해진다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ye_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/card_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ye_space_xs"
        android:paddingTop="@dimen/ye_space_xs"
        android:paddingEnd="@dimen/ye_gutter"
        android:paddingBottom="@dimen/ye_space_xs">

        <ImageButton
            android:id="@+id/card_back"
            android:layout_width="@dimen/ye_touch_min"
            android:layout_height="@dimen/ye_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ye_back"
            android:padding="@dimen/ye_space_sm"
            android:src="@drawable/ic_ye_arrow_back"
            app:tint="@color/ye_on_surface" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/card_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="invisible"
        tools:visibility="visible" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/ye_gutter"
        android:paddingTop="@dimen/ye_space_xs">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/ye_space_lg">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_container"
                style="@style/Ye.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/ye_radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ye_space_xl">

                    <ImageView
                        android:layout_width="@dimen/ye_icon_xl"
                        android:layout_height="@dimen/ye_icon_xl"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ye_sparkle"
                        app:tint="@color/ye_primary" />

                    <TextView
                        android:id="@+id/card_headline"
                        style="@style/Ye.Text.Headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ye_space_sm"
                        tools:text="경복궁 대신 창덕궁" />

                    <TextView
                        android:id="@+id/card_facts"
                        style="@style/Ye.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ye_space_sm"
                        android:backgroundTint="@color/ye_primary_container"
                        android:textColor="@color/ye_on_primary_container"
                        android:textSize="13sp"
                        tools:text="혼잡도 60% 낮음" />

                    <TextView
                        android:id="@+id/card_body"
                        style="@style/Ye.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ye_space_md"
                        tools:text="같은 고궁의 결을 지녔지만 그 시간엔 훨씬 한적합니다." />

                    <TextView
                        android:id="@+id/card_genby"
                        style="@style/Ye.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ye_space_md"
                        tools:text="근거 기반 문구" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/card_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ye_bg_top_hairline"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/ye_gutter"
        android:paddingVertical="@dimen/ye_space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/card_share"
            style="@style/Ye.Button.Icon.Tonal"
            android:layout_width="@dimen/ye_button_h"
            android:layout_height="@dimen/ye_button_h"
            android:layout_marginEnd="@dimen/ye_space_xs"
            android:contentDescription="@string/alt_share_image"
            app:icon="@drawable/ic_ye_image" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/card_swap"
            style="@style/Ye.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/ye_button_h"
            android:layout_weight="1"
            android:text="@string/alt_swap"
            app:icon="@drawable/ic_ye_swap" />
    </LinearLayout>
</LinearLayout>
