# 여백 서버 환경변수 예시. 이 파일을 `.env` 로 복사해서 채운다(.env 는 git 에 올리지 말 것).
# 키가 없어도 서버는 뜬다 — 혼잡 예보가 중립값으로 폴백될 뿐이다.

# 서울 실시간 도시데이터 — 도착시점 혼잡 예보(가장 중요)
SEOUL_API_KEY=
# 한국관광공사 TourAPI — 장소 수집(수집 스크립트에서 사용)
TOURAPI_KEY=
# 전국 관광지 집중률 예측 — 서울 밖 혼잡
TATS_API_KEY=

# 호스트에 열 포트(docker compose 에서 사용). 앱의 DEV_BASE_URL 과 맞출 것.
YEOBAEK_PORT=8000

# 실시간 급증 감시(SSE) 튜닝 — 기본값으로 충분하다.
# YEOBAEK_SURGE_INTERVAL=10
# YEOBAEK_SURGE_PING=25
# YEOBAEK_HIGH_LVL=3

# RAG 설득 카드에 LLM 재서술을 쓰려면(선택)
# YEOBAEK_USE_LLM=1
# ANTHROPIC_API_KEY=
